# AEGIS Backend Configuration Example

# Phase 2: Aegis Engine & Cache
AEGIS_SAFE_THRESHOLD=30
AEGIS_CRITICAL_THRESHOLD=70
AEGIS_CACHE_TTL_SECONDS=3600

# Phase 3: Cybersecurity Analysis
AEGIS_CYBER_ANALYSIS_ENABLED=true
AEGIS_THREAT_INTEL_ENABLED=false
AEGIS_DNS_TIMEOUT=2.0
AEGIS_HTTP_TIMEOUT=3.0
AEGIS_TLS_TIMEOUT=3.0
AEGIS_REDIRECT_TIMEOUT=2.0
AEGIS_MAX_REDIRECTS=5
AEGIS_MAX_RESPONSE_BYTES=1048576

# Phase 4: Local AI Analysis
AEGIS_AI_ENABLED=true
AEGIS_AI_PROVIDER=ollama
AEGIS_AI_MODEL=qwen3:4b-instruct
AEGIS_AI_BASE_URL=http://localhost:11434
AEGIS_AI_TIMEOUT=10.0
AEGIS_AI_TEMPERATURE=0.1
AEGIS_AI_MAX_TOKENS=512
AEGIS_AI_MAX_FINDINGS=5
AEGIS_AI_MAX_TEXT_LENGTH=500

# Phase 5: FastAPI Application & Server
AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
AEGIS_MAX_URL_LENGTH=8192
AEGIS_ENVIRONMENT=development

# Third-Party Integrations (Optional)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=